new file mode 100644
--- /dev/null
+++ b/win-linux/src/qtcomp/qt6/QX11Info
@@ -0,0 +1,6 @@
+#pragma once
+
+// Qt 6 removed the public <QX11Info> header (Qt5 x11extras). The same class
+// lives in Qt Gui's private extras. This file is on INCLUDEPATH only for Qt 6,
+// so the existing #include <QX11Info> lines keep working.
+#include <QtGui/private/qtx11extras_p.h>
