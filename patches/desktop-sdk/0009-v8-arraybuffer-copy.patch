 	IMPLEMENT_REFCOUNTING(CAscCefV8ArrayBufferReleaseCallback);
 };
+
+// CreateArrayBuffer returns nullptr when the V8 sandbox is enabled, which
+// is the default in CEF 155. The document then never receives Editor.bin.
+static CefRefPtr<CefV8Value> CreateOpenedFileBuffer(BYTE* pData, size_t nLen)
+{
+#if defined(CEF_VERSION_155) || (defined(CEF_VERSION_MAJOR) && CEF_VERSION_MAJOR >= 133)
+	CefRefPtr<CefV8Value> value = CefV8Value::CreateArrayBufferWithCopy((void*)pData, nLen);
+	delete[] pData;
+	return value;
+#else
+	return CefV8Value::CreateArrayBuffer((void*)pData, nLen, new CAscCefV8ArrayBufferReleaseCallback());
+#endif
+}
 #endif
 
