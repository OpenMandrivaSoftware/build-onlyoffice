+use_system_cef {
+	# Distro libcef_dll_wrapper is built with -fno-rtti, so CefStreamResourceHandler
+	# has no typeinfo. cefview.cpp subclasses it and must be compiled the same way,
+	# or loading the library fails on _ZTI24CefStreamResourceHandler.
+	SOURCES -= $$PWD/src/cefview.cpp
+	NORTTI_SOURCES += $$PWD/src/cefview.cpp
+	nortti_cxx.input = NORTTI_SOURCES
+	nortti_cxx.output = ${OBJECTS_DIR}nortti_${QMAKE_FILE_BASE}.o
+	nortti_cxx.commands = $${QMAKE_CXX} -c $(CXXFLAGS) -fno-rtti $(INCPATH) ${QMAKE_FILE_IN} -o ${QMAKE_FILE_OUT}
+	nortti_cxx.variable_out = OBJECTS
+	nortti_cxx.name = compiling[nortti] ${QMAKE_FILE_IN}
+	nortti_cxx.dependency_type = TYPE_C
+	QMAKE_EXTRA_COMPILERS += nortti_cxx
+}
