 #include "./TextShaper.h"
 #include "./TextShaper_p.h"
+#include <mutex>
+#include <unordered_map>
+
+namespace
+{
+	struct FtFaceHook
+	{
+		FT_Library library;
+		int refs;
+	};
+
+	std::mutex g_ft_lib_mutex;
+	std::unordered_map<FT_Library, int> g_ft_lib_refs;
+
+	void ft_lib_track_new(FT_Library library)
+	{
+		if (!library)
+			return;
+		std::lock_guard<std::mutex> lock(g_ft_lib_mutex);
+		g_ft_lib_refs[library] = 1;
+	}
+
+	void ft_lib_track_ref(FT_Library library)
+	{
+		std::lock_guard<std::mutex> lock(g_ft_lib_mutex);
+		auto it = g_ft_lib_refs.find(library);
+		if (it != g_ft_lib_refs.end())
+			it->second++;
+	}
+
+	void ft_lib_track_forget(FT_Library library)
+	{
+		std::lock_guard<std::mutex> lock(g_ft_lib_mutex);
+		g_ft_lib_refs.erase(library);
+	}
+
+	// Remaining count after the drop, or -1 when this library is not tracked.
+	int ft_lib_track_unref(FT_Library library)
+	{
+		std::lock_guard<std::mutex> lock(g_ft_lib_mutex);
+		auto it = g_ft_lib_refs.find(library);
+		if (it == g_ft_lib_refs.end())
+			return -1;
+		int left = --(it->second);
+		if (left <= 0)
+			g_ft_lib_refs.erase(it);
+		return left;
+	}
+}
 
