diff --git a/Apple/StringDocumentHandler.h b/Apple/StringDocumentHandler.h
new file mode 100644
index 0000000000..64c518d696
--- /dev/null
+++ b/Apple/StringDocumentHandler.h
@@ -0,0 +1,26 @@
+#ifndef STRINGDOCUMENTHANDLER_H
+#define STRINGDOCUMENTHANDLER_H
+
+#include <libodfgen/OdfDocumentHandler.hxx>
+
+// Collects the flat ODF XML that libodfgen writes. libodfgen ships this as a
+// test helper, and the distro package does not install it.
+class StringDocumentHandler : public OdfDocumentHandler
+{
+public:
+	StringDocumentHandler();
+
+	void startDocument() override;
+	void endDocument() override;
+	void startElement(const char *psName, const librevenge::RVNGPropertyList &xPropList) override;
+	void endElement(const char *psName) override;
+	void characters(const librevenge::RVNGString &sCharacters) override;
+
+	const char *cstr() const { return m_data.cstr(); }
+
+private:
+	librevenge::RVNGString m_data;
+	bool m_tagOpened;
+};
+
+#endif
diff --git a/Apple/StringDocumentHandler.cpp b/Apple/StringDocumentHandler.cpp
new file mode 100644
index 0000000000..b1f9d644fa
--- /dev/null
+++ b/Apple/StringDocumentHandler.cpp
@@ -0,0 +1,68 @@
+#include "StringDocumentHandler.h"
+
+#include <cstring>
+
+StringDocumentHandler::StringDocumentHandler() : m_tagOpened(false)
+{
+}
+
+void StringDocumentHandler::startDocument()
+{
+}
+
+void StringDocumentHandler::endDocument()
+{
+	if (m_tagOpened)
+	{
+		m_data.append(">");
+		m_tagOpened = false;
+	}
+}
+
+void StringDocumentHandler::startElement(const char *psName, const librevenge::RVNGPropertyList &xPropList)
+{
+	if (m_tagOpened)
+	{
+		m_data.append(">");
+		m_tagOpened = false;
+	}
+	m_data.append("<");
+	m_data.append(psName);
+	librevenge::RVNGPropertyList::Iter i(xPropList);
+	for (i.rewind(); i.next(); )
+	{
+		if (std::strncmp(i.key(), "libwpd", 6) == 0)
+			continue;
+		m_data.append(" ");
+		m_data.append(i.key());
+		m_data.append("=\"");
+		m_data.append(librevenge::RVNGString::escapeXML(i()->getStr()));
+		m_data.append("\"");
+	}
+	m_tagOpened = true;
+}
+
+void StringDocumentHandler::endElement(const char *psName)
+{
+	if (m_tagOpened)
+	{
+		m_data.append("/>");
+		m_tagOpened = false;
+	}
+	else
+	{
+		m_data.append("</");
+		m_data.append(psName);
+		m_data.append(">");
+	}
+}
+
+void StringDocumentHandler::characters(const librevenge::RVNGString &sCharacters)
+{
+	if (m_tagOpened)
+	{
+		m_data.append(">");
+		m_tagOpened = false;
+	}
+	m_data.append(librevenge::RVNGString::escapeXML(sCharacters));
+}
