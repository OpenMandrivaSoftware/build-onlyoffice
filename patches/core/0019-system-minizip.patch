+# Linux links system zlib and system minizip-ng through the classic compat
+# API (pkg-config name minizip). ioapibuf.c is OnlyOffice's in-memory zip
+# backend and stays on every platform. zlib_addon.c stays because
+# OfficeUtils calls it directly. The 1.2.11 tree must stay off the Linux
+# include path: <zlib.h>, "ioapi.h", "unzip.h" and "zip.h" would otherwise
+# still resolve to the bundled copies. Other platforms compile that tree.
 unix:!mac:!android {
+    CONFIG += link_pkgconfig
+    PKGCONFIG += minizip
